# URL pública do banco Neon, sem usuário ou senha.
NEXT_PUBLIC_NEON_DATABASE_URL=https://ep-mute-glitter-b6hglkab.c-2.sa-east-1.aws.neon.tech/neondb

# Necessária somente para aplicar migrations ou preparar a seed.
# Copie a connection string privada do botão Connect no painel Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full

# E-mail da conta do Neon Auth que receberá a seed de demonstração.
# Se vazio, o comando npm run db:seed perguntará o e-mail no terminal.
NEON_DEV_USER_EMAIL=

# Chave privada da WineAPI, usada somente pelas rotas do servidor.
WINEAPI_API_KEY=

# Barcode identification provider controls. All optional providers are off by default.
# WineAPI's current terms restrict the free tier to personal, non-commercial use.
ENABLE_WINEAPI_IDENTIFICATION=false

# Brave Search is paid after any available credit. Enable only after choosing a plan/budget.
BRAVE_SEARCH_API_KEY=
ENABLE_EXTERNAL_WEB_SEARCH=false

# OpenAI calls require both a key and an explicit server-side feature flag, plus per-request user consent.
OPENAI_API_KEY=
OPENAI_IDENTIFICATION_MODEL=gpt-4.1-mini
ENABLE_OPENAI_IDENTIFICATION=false
